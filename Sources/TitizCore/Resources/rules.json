    { "wrong": "hicbirsey", "correct": "hiçbir şey", "ruleID": "spell.joint.closed_tdk", "asciiVariantOnly": true },
    { "wrong": "hoscakal", "correct": "hoşça kal", "ruleID": "spell.joint.closed_tdk", "asciiVariantOnly": true },
