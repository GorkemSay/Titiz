    { "wrong": "sağol", "correct": "sağ ol", "ruleID": "spell.closed_tdk.lexicon", "asciiVariantOnly": false },
    { "wrong": "hoşçakal", "correct": "hoşça kal", "ruleID": "spell.closed_tdk.lexicon", "asciiVariantOnly": false },
    { "wrong": "ardarda", "correct": "art arda", "ruleID": "spell.closed_tdk.lexicon", "asciiVariantOnly": false },
